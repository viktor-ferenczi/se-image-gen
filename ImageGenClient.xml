<?xml version="1.0"?>
<PluginData
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="GitHubPlugin"
>
  <!-- The ID of your plugin, never change this -->
  <Id>DD45EEE2-E0BC-420E-9787-35E4EE7E75A1</Id>

  <!-- GitHub repository ID -->
  <RepoId>viktor-ferenczi/se-image-gen</RepoId>

  <!-- The name of your plugin that will appear in the plugin list -->
  <FriendlyName>LCD Image Generation</FriendlyName>

  <!-- The author name that you want to appear in the plugin list -->
  <Author>Viktor</Author>

  <!-- Optional tooltip for the plugin in the plugin list -->
  <Tooltip>Write /ig &lt;prompt&gt; on an LCD to show a generated image there</Tooltip>

  <!-- Optional plugin description. If omitted, this will be the same as the Tooltip. 1000 characters max. -->
  <Description>Write /ig followed by a prompt as the text of an LCD or any other screen, and an image model draws the picture onto that screen in color characters.
        Works offline and when hosting a friends game; joined players need no plugin.
        Needs the MOSS-Image model running in a stable-diffusion.cpp sd-server, see the plugin's README.
    </Description>

  <!-- Only source code in the Directory entries listed in SourceDirectories is compiled. Exclude any test projects or similar. -->
  <SourceDirectories>
    <Directory>ClientPlugin</Directory>
    <Directory>Shared</Directory>
  </SourceDirectories>

  <!-- To specify asset files to be copied onto disk, use an Asset tag named AssetFolder. Path is relative to the repository root.
    <Asset Name="AssetFolder" Path="ClientPlugin/Assets/"/>
    -->

  <!-- To specify required NuGet packages, use a list of PackageReference tags.
    <NuGetReferences>
      <PackageReference Include="OVRSharp" Version="1.2.0" />
    </NuGetReferences> 
    -->

  <!-- Optional tag that specifies what dependencies this plugin has. Dependencies will be automatically enabled when this plugin is enabled.
    <DependencyIds>
      <Id>TODO ID of the plugin this one depends on</Id>
    </DependencyIds> 
    -->

  <!-- Optional tag that restricts the plugin to specific runtimes (case insensitive: CLR for .NET Framework, Mono for Proton, CoreCLR for .NET 10). List multiple, comma separated. If omitted, the plugin loads on all runtimes.
    <Runtimes>CLR,CoreCLR</Runtimes>
    -->

  <!-- Optional tag that restricts the plugin to specific platforms (case insensitive: Windows, Linux, Proton). List multiple, comma separated. If omitted, the plugin loads on all platforms.
    <Platforms>Windows,Linux</Platforms>
    -->

  <!-- Optional tag that specifies whether the plugin is hidden. Hidden plugins only appear when they are enabled or searched for in the search box.
    <Hidden>true</Hidden>
    -->

  <!-- The current plugin version's commit hash -->
  <Commit>TODO commit hash once the repository exists</Commit>

  <!-- Optional list of alternate versions of the plugin, use it for test or custom builds
    <AlternateVersions>
      <Version>
        <Name>Version Name</Name>
        <Commit>Commit hash</Commit>
      </Version>
    </AlternateVersions> 
    -->

  <!-- Feel free to delete the comments and the commented out optional blocks once you're done. -->
</PluginData>
